__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/
*.DS_Store
data/raw/*.pdf
data/interim/

# Tooling interno de desarrollo (prompts de agentes de Claude Code), no
# parte del producto — se mantiene local, no se publica.
.claude/

# Variables de entorno locales (nunca versionar credenciales)
.env
*.env

# Puerto Node.js (latio-node/) — dependencias instalables vía npm install
latio-node/node_modules/

# Paquetes armados para subir a mano al hosting. Son COPIAS de archivos que
# ya viven versionados (toolkit-api/index.html, latio-node/server/...), y
# versionar la copia es garantizar que en algún momento se desincronice de su
# original. Se arman cuando hacen falta y se descartan.
*.zip
*.bundle

# Carpeta de borradores y capturas de trabajo, no es parte del producto.
Claude outputs/
